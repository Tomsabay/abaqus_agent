{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Abaqus Agent",
  "version": "0.1.0",
  "identifier": "com.aisim.abaqusagent",
  "build": {
    "frontendDist": "../tauri_ui"
  },
  "app": {
    "windows": [
      {
        "title": "Abaqus Agent — 仿真工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../dist/abaqus-agent-server": "backend"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
